diff --git a/sub/ass_mp.c b/sub/ass_mp.c
index 7e81bb266d..2d13e20fb3 100644
--- a/sub/ass_mp.c
+++ b/sub/ass_mp.c
@@ -80,12 +80,31 @@ void mp_ass_configure_fonts(ASS_Renderer *priv, struct osd_style_opts *opts,
                             struct mpv_global *global, struct mp_log *log)
 {
     void *tmp = talloc_new(NULL);
